---
import "../styles/tokens.css";
import "../styles/global.css";
import { site } from "../data/profile";

interface Props { title: string; description: string; path?: string; }
const { title, description } = Astro.props;
const pageTitle = title === site.fullName ? `${site.fullName} · ${site.designation}` : `${title} · ${site.fullName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL("/og-image.png", Astro.site ?? site.url).href;
const nav = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/experience/", label: "Experience" },
  { href: "/projects/", label: "Projects" },
  { href: "/certifications/", label: "Certifications" },
  { href: "/writing/", label: "Writing" },
  { href: "/contact/", label: "Contact" },
];
const current = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isCurrent = (href: string) => (href === "/" ? current === "/" : current.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.fullName} />
    <meta name="theme-color" content="#0B5F7E" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-800.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.fullName} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="topbar" aria-hidden="true"></div>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${site.name} — home`}>
          <img src="/images/symbol.svg" alt="" width="36" height="36" />
          <span>{site.name}</span>
        </a>
        <nav class="nav" aria-label="Main">
          <ul>
            {nav.map((n) => <li><a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a></li>)}
          </ul>
        </nav>
        <details class="menu">
          <summary aria-label="Open menu">Menu</summary>
          <nav aria-label="Main (mobile)">
            <ul>
              {nav.map((n) => <li><a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a></li>)}
            </ul>
          </nav>
        </details>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div>
          <strong>{site.fullName}</strong>
          <span class="muted"> · {site.designation} · {site.location}</span>
          <p class="small muted" style="margin:6px 0 0">Writing as <a href={site.links.blog}>The Fusion Platform by Sohan</a>. Not affiliated with Microsoft.</p>
        </div>
        <div class="footer-links">
          <a class="icon-link" href={site.links.linkedin}><img src="/images/linkedin-inbug.png" alt="" width="20" height="17" />LinkedIn</a>
          <a class="icon-link" href={site.links.github}>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#0B5F7E" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M8 7l-5 5 5 5"/><path d="M16 7l5 5-5 5"/></svg>GitHub</a>
          <a class="icon-link" href={site.links.blog}>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#0B5F7E" stroke-width="1.75" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9" stroke="#209CCB"/><path d="M3 12h18M5 7h14M5 17h14"/></svg>Blog</a>
          <a class="icon-link" href={`mailto:${site.email}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#0B5F7E" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6" stroke="#209CCB"/></svg>Email</a>
        </div>
      </div>
    </footer>
  </body>
</html>
