---
import Base from "../layouts/Base.astro";
import { certifications, certLevels } from "../data/profile";
const total = certifications.active.length + certifications.previous.length;
const badge = {
  Expert: "/images/badges/expert.svg",
  Associate: "/images/badges/associate.svg",
  Fundamentals: "/images/badges/fundamentals.svg",
};
const activeByLevel = certLevels
  .map((level) => ({ level, items: certifications.active.filter((c) => c.level === level) }))
  .filter((g) => g.items.length);
const id = (level: string) => `level-${level.toLowerCase()}`;
---
<Base title="Certifications" description="Sohan's Microsoft certifications by level (Expert, Associate, Fundamentals), previously held certifications, Applied Skills credentials and training.">
  <section class="page-head"><div class="wrap">
    <p class="eyebrow">Certifications</p>
    <h1>Microsoft <span class="grad-text">certifications</span></h1>
    <p>{total} Microsoft certifications earned, {certifications.active.length} currently active, plus {certifications.appliedSkills.length} Applied Skills credentials.</p>
    <ul class="badge-summary" aria-label="Active credentials by level">
      {activeByLevel.map((g) => (
        <li><a href={`#${id(g.level)}`}><img src={badge[g.level]} alt="" width="56" height="56" /><span><strong>{g.items.length}</strong> {g.level}</span></a></li>
      ))}
      <li><a href="#applied-title"><img src="/images/badges/applied-skill.svg" alt="" width="56" height="56" /><span><strong>{certifications.appliedSkills.length}</strong> Applied Skills</span></a></li>
    </ul>
  </div></section>

  <section class="section" aria-labelledby="active-title">
    <div class="wrap">
      <div class="section-head"><h2 id="active-title">Active certifications</h2></div>
      {activeByLevel.map((g) => (
        <div class="cert-group">
          <h3 id={id(g.level)} class="cert-level">{g.level}</h3>
          <div class="grid two">
            {g.items.map((c) => (
              <article class="card cert">
                <img class="cert-badge" src={badge[c.level]} alt={`Microsoft Certified ${c.level} badge`} width="84" height="84" loading="lazy" />
                <div>
                  <h4>{c.name}</h4>
                  <p class="small muted">Exam {c.exam} · Issued {c.issued}</p>
                  <span class="status active">Active</span>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section alt" aria-labelledby="previous-title">
    <div class="wrap">
      <div class="section-head"><h2 id="previous-title">Previously held</h2></div>
      <p class="muted prose">These certifications have expired. They're listed for the record, not as current credentials. The exams were passed; the certifications weren't renewed.</p>
      <div class="grid two">
        {certifications.previous.map((c) => (
          <article class="card cert">
            <img class="cert-badge exam" src="/images/badges/past-exam.svg" alt="Microsoft exam badge" width="63" height="84" loading="lazy" />
            <div>
              <h4>{c.name}</h4>
              <p class="small muted">Exam {c.exam} · {c.level} level</p>
              <span class="status previous">Expired</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="applied-title">
    <div class="wrap">
      <div class="section-head"><h2 id="applied-title">Microsoft Applied Skills</h2></div>
      <p class="muted prose">Applied Skills are hands-on, lab-based credentials, separate from certifications.</p>
      <div class="grid two">
        {certifications.appliedSkills.map((c) => (
          <article class="card cert">
            <img class="cert-badge" src="/images/badges/applied-skill.svg" alt="Microsoft Applied Skills badge" width="84" height="84" loading="lazy" />
            <div>
              <h4>{c}</h4>
              <p class="small muted">Applied Skills credential</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt" aria-labelledby="training-title">
    <div class="wrap">
      <div class="section-head"><h2 id="training-title">Training</h2></div>
      <div class="grid two">
        {certifications.training.map((t) => (
          <article class="card"><h3>{t.provider}</h3><ul class="list">{t.courses.map((c) => <li>{c}</li>)}</ul></article>
        ))}
      </div>
      <p class="small muted footnote">Microsoft, Microsoft Certified and the certification badges are trademarks of the Microsoft group of companies. The badges are shown only to represent credentials earned; no affiliation or endorsement is implied.</p>
    </div>
  </section>
</Base>
