---
import Base from "../layouts/Base.astro";
import { projects } from "../data/profile";
---
<Base title="Projects" description="Power Platform projects by Sohan: what was built, why, and what the tests showed.">
  <section class="page-head"><div class="wrap">
    <p class="eyebrow">Projects</p>
    <h1>Projects and <span class="grad-text">case studies</span></h1>
    <p>Each project covers the problem, what I built, the result and the source code. All data in them is fictional demo data.</p>
  </div></section>

  <section class="section">
    <div class="wrap">
      <div class="grid two">
        {projects.map((p) => (
          <article class="card project-card">
            <p class="eyebrow small-eyebrow">{p.area}</p>
            <h2 class="card-title"><a href={`/projects/${p.slug}/`}>{p.title}</a></h2>
            <p>{p.value}</p>
            <ul class="tags" aria-label="Tech stack">
              {p.tags.map((t) => <li>{t}</li>)}
            </ul>
            <p class="card-cta" aria-hidden="true">Read the case study →</p>
          </article>
        ))}
      </div>
      <div class="callout" style="margin-top:28px">
        <p class="label">Want the details?</p>
        <p style="margin:0">Happy to walk you through any of these in a conversation. <a href="/contact/">Get in touch</a>.</p>
      </div>
    </div>
  </section>
</Base>
