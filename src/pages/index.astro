---
import Base from "../layouts/Base.astro";
import { site, about, certifications, writing } from "../data/profile";
---
<Base title={site.fullName} description={`${site.positioning} Based in ${site.location}.`}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div>
        <p class="eyebrow">{site.fullName} · {site.location}</p>
        <h1 id="hero-title">Think deeper.<br /><span class="grad-text">Build smarter.</span></h1>
        <p class="designation">{site.designation}</p>
        <p class="lead">{site.positioning}</p>
        <div class="actions">
          <a class="btn btn-primary" href="/projects/">See my work</a>
          <a class="btn btn-secondary" href="/contact/">Get in touch</a>
        </div>
      </div>
      <div class="hero-photo">
        <picture>
          <source type="image/webp" srcset="/images/sohan-320.webp 320w, /images/sohan-640.webp 640w" sizes="(min-width: 900px) 320px, 72vw" />
          <img src="/images/sohan-640.jpg" alt={`Portrait of ${site.fullName}`} width="640" height="640" fetchpriority="high" />
        </picture>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="build-title">
    <div class="wrap">
      <div class="section-head"><h2 id="build-title">What I build</h2></div>
      <div class="grid four">
        {about.build.map((b) => <article class="card"><h3>{b.title}</h3><p class="muted">{b.text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section alt" aria-labelledby="numbers-title">
    <div class="wrap">
      <div class="section-head"><h2 id="numbers-title">In numbers</h2></div>
      <div class="grid three">
        <div class="card"><p class="h-num grad-text" style="font-family:var(--font-display);font-weight:800;font-size:2.6rem;line-height:1;margin:0 0 8px">4+</p><p class="muted" style="margin:0">years building on the Power Platform at Data Crafters</p></div>
        <div class="card"><p class="grad-text" style="font-family:var(--font-display);font-weight:800;font-size:2.6rem;line-height:1;margin:0 0 8px">15+</p><p class="muted" style="margin:0">custom apps and workflows delivered</p></div>
        <div class="card"><p class="grad-text" style="font-family:var(--font-display);font-weight:800;font-size:2.6rem;line-height:1;margin:0 0 8px">{certifications.active.length}</p><p class="muted" style="margin:0">active Microsoft certifications, {certifications.active.filter((c) => c.level === "Expert").length} at Expert level</p></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="writing-title">
    <div class="wrap">
      <div class="section-head"><h2 id="writing-title">Latest writing</h2></div>
      <p class="prose">I share practical Power Platform notes on <a href={site.links.blog}>The Fusion Platform by Sohan</a>: tutorials, comparisons and architecture thinking.</p>
      <div class="grid three">
        {writing.map((w) => <article class="card"><p class="small muted" style="margin:0 0 6px">{w.date}</p><h3><a href={w.url}>{w.title}</a></h3></article>)}
      </div>
      <div class="actions"><a class="btn btn-secondary" href="/writing/">All writing</a></div>
    </div>
  </section>
</Base>
